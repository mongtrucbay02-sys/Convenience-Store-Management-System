# Mẫu biến môi trường. Chép thành .env (không commit .env) hoặc đặt bằng export / user-secrets.
# #4 bổ sung phần Docker Compose (issue T3-21 trên GitHub, T3-25 trong Bảng Task).

# CSDL MySQL 9.7.2 cho ứng dụng (ADR-001)
ConnectionStrings__CuaHang=server=localhost;port=3306;database=cuahang_dev;user=root;password=

# T4-16: tài khoản Admin đầu tiên, chỉ tạo khi CSDL chưa có tài khoản vai trò AD.
# Tên: chữ không dấu, số, dấu chấm, gạch dưới (3–50). Mật khẩu tạm: 8–128 ký tự, có chữ và số.
AdminDauTien__TenDangNhap=
AdminDauTien__MatKhauTam=

# T4-17: MySQL cho bộ test (tài khoản có quyền CREATE/DROP DATABASE; phần database bị bỏ qua).
ConnectionStrings__CuaHangTest=server=localhost;port=3306;user=root;password=
