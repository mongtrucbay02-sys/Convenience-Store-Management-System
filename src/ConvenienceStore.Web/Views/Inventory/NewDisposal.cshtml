@model IReadOnlyList<ConvenienceStore.Web.Modules.Inventory.Controllers.DisposalProduct>
@using ConvenienceStore.Web.Modules.Auth.Security
@{ ViewData["Title"] = "Lập phiếu xuất hủy"; }
<h1>Lập phiếu xuất hủy</h1>
@if (TempData["Loi"] is string error) { <p class="alert alert-danger">@error</p> }
@if (Model.Count == 0) { <p>Không có sản phẩm còn tồn.</p> }
else
{
    <p>Nhập số lượng cho sản phẩm cần xuất hủy.</p>
    <form asp-action="CreateDisposal" method="post">
        <table class="table">
            <thead><tr><th>Sản phẩm</th><th>Tồn hiện tại</th><th>Số lượng hủy</th><th>Lý do</th><th>Ghi chú</th>@if (User.IsInRole(BangQuyen.Admin)) { <th>Giá vốn hiện tại</th> }</tr></thead>
            <tbody>
            @for (var i = 0; i < Model.Count; i++)
            {
                var product = Model[i];
                <tr><td>@product.Name</td><td>@product.OnHand</td>
                    <td><input type="hidden" name="lines[@i].ProductId" value="@product.Id"><input name="lines[@i].Quantity" type="number" min="1" max="@product.OnHand" aria-label="Số lượng hủy"></td>
                    <td><select name="lines[@i].Reason" aria-label="Lý do"><option value="">Chọn lý do</option><option value="HONG">Hỏng</option><option value="HET_HAN">Hết hạn</option><option value="MAT">Mất</option><option value="KHAC">Khác</option></select></td>
                    <td><input name="lines[@i].Note" maxlength="255" aria-label="Ghi chú"></td>
                    @if (User.IsInRole(BangQuyen.Admin)) { <td>@product.Cost.ToString("N2")</td> }
                </tr>
            }
            </tbody>
        </table>
        <button class="btn btn-outline-secondary" name="submit" value="false">Lưu nháp</button>
        <button class="btn btn-primary" name="submit" value="true">Lưu và gửi duyệt</button>
    </form>
}
<p class="mt-3"><a asp-action="Index">Về chứng từ kho</a></p>
