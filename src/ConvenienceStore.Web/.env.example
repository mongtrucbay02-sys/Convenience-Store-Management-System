# =====================================================================
# Smart Mart - cấu hình kết nối CSDL (mẫu)
# 1. Sao chép file này thành .env trong CÙNG thư mục (cạnh ConvenienceStore.Web.csproj).
# 2. Thay các giá trị <...> bằng thông tin Yến gửi riêng.
# 3. KHÔNG commit file .env (CONTRIBUTING.md mục 4).
# App đọc theo thứ tự: biến môi trường -> file .env -> appsettings (Data/KetNoiCsdl.cs).
# =====================================================================

# Supabase PostgreSQL 17 qua session pooler. Chỉ dùng user smartmart_backend.<PROJECT_REF>.
# Search Path và Timezone được app tự ép lại; giữ ở đây để đọc cho rõ.
ConnectionStrings__CuaHang=Host=<POOLER_HOST>;Port=5432;Database=postgres;Username=smartmart_backend.<PROJECT_REF>;Password=<MAT_KHAU>;SSL Mode=VerifyFull;Root Certificate=<DUONG_DAN_FILE_CA>;Search Path=smartmart;Timezone=Asia/Ho_Chi_Minh

# Tạo tài khoản Admin đầu tiên khi CSDL chưa có Admin. Để trống nếu đã có.
AdminDauTien__TenDangNhap=
AdminDauTien__MatKhauTam=
