# Copy to src/ConvenienceStore.Web/.env. Never commit the completed .env.
# Existing smartmart schema is required; do not run legacy MySQL migrations.
Database__Provider=PostgreSql
ConnectionStrings__CuaHang="Host=aws-1-ap-northeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Require;Search Path=smartmart;"
