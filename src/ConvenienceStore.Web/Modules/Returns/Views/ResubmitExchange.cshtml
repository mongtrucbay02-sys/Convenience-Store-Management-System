@model ConvenienceStore.Web.Modules.Returns.Services.ExchangePlanResubmission
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Xác nhận gửi lại phương án đổi";
}
<h1>Gửi lại phương án đổi @Model.Details.Slip.Code</h1>
<p>Phương án mới sẽ thay thế hiệu lực của bản đã duyệt. Chưa ghi hóa đơn, kho, tiền mặt hoặc điểm ở bước này.</p>
<div class="table-responsive"><table class="table">
    <thead><tr><th>Hàng mới</th><th>Số lượng</th><th>Đơn giá</th><th>Giảm mỗi đơn vị</th></tr></thead>
    <tbody>@foreach (var line in Model.Proposal.Lines)
    {<tr><td>@line.Name (#@line.ProductId)</td><td>@line.Quantity</td><td>@line.UnitPrice.ToString("N0") đ</td><td>@line.Discount.ToString("N0") đ</td></tr>}</tbody>
</table></div>
<p>Tổng @Model.Proposal.Total.ToString("N0") đ · Khách trả thêm @Model.Proposal.CashDue.ToString("N0") đ.</p>
<form method="post" action="@Url.Action("Resubmit", "ReturnApprovals", new { id = Model.Details.Slip.Id })">
    @Html.AntiForgeryToken()
    <input type="hidden" name="token" value="@Model.Token" />
    <button class="btn btn-primary" type="submit">Gửi Admin duyệt lại</button>
</form>
<a href="@Url.Action("ApprovedExchange", "ReturnApprovals", new { id = Model.Details.Slip.Id })">Quay lại phiếu</a>
