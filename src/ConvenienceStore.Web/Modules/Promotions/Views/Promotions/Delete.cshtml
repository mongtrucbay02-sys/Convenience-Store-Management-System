@using ConvenienceStore.Web.Modules.Promotions.Services
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model PromotionHistory
@{Layout="~/Views/Shared/_AdminLayout.cshtml";ViewData["Title"]="Xác nhận xóa khuyến mãi";}
<section class="card p-4" style="max-width:760px"><h1>Xóa chương trình khuyến mãi?</h1><p><strong>@Model.Code · @Model.Name</strong></p>
<p>Chỉ xóa chương trình tạo nhầm, chưa được dùng và không gắn với đơn hàng. Nếu đã có tham chiếu lịch sử, hãy dùng “Kết thúc”.</p>
@if(Model.Uses.Count>0){<div class="alert alert-warning">Đã có @Model.Uses.Count lượt sử dụng; không thể xóa.</div>}
else {<form asp-action="Delete" asp-route-id="@Model.Id" method="post"><input type="hidden" name="version" value="@Model.Version" /><label class="d-block mb-3"><input type="checkbox" name="confirmed" value="true" required /> Tôi xác nhận xóa chương trình này.</label><button class="btn btn-danger" type="submit">Xác nhận xóa</button></form>}
<div class="mt-3"><a class="btn btn-outline-secondary" asp-action="Index">Hủy / quay lại</a></div></section>
