  "functions": [
    {
      "name": "fn_guard_hoa_don",
      "owner": "postgres",
      "acl": [
        "postgres=X/postgres"
      ],
      "security_definer": false,
      "config": [
        "search_path=\"\""
      ],
      "returns": "trigger",
      "body": "BEGIN\n  IF TG_OP='DELETE' THEN\n    RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='hoa_don cannot be deleted';\n  END IF;\n  IF OLD.trang_thai IS DISTINCT FROM 'DA_THANH_TOAN'\n     OR NEW.trang_thai IS DISTINCT FROM 'DA_HUY'\n     OR (to_jsonb(NEW) - ARRAY['trang_thai','nguoi_huy_id','huy_luc','ly_do_huy']::text[])\n        IS DISTINCT FROM\n        (to_jsonb(OLD) - ARRAY['trang_thai','nguoi_huy_id','huy_luc','ly_do_huy']::text[])\n  THEN\n    RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='hoa_don only permits cancellation with immutable financial snapshot';\n  END IF;\n  RETURN NEW;\nEND;",
      "backend_execute": false
    },
    {
      "name": "fn_prevent_history_mutation",
      "owner": "postgres",
      "acl": [
        "postgres=X/postgres"
      ],
      "security_definer": false,
      "config": [
        "search_path=\"\""
      ],
      "returns": "trigger",
      "body": "BEGIN\n  RAISE EXCEPTION USING ERRCODE='23514',\n    MESSAGE=format('%s is append-only: %s forbidden', TG_TABLE_NAME, TG_OP);\nEND;",
      "backend_execute": false
    },
    {
      "name": "fn_updated_at",
      "owner": "postgres",
      "acl": [
        "postgres=X/postgres"
      ],
      "security_definer": false,
      "config": [
        "search_path=\"\""
      ],
      "returns": "trigger",
      "body": "BEGIN NEW.ngay_cap_nhat:=clock_timestamp(); RETURN NEW; END",
      "backend_execute": false
    }
