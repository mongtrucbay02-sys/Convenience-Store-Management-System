@model IReadOnlyList<ConvenienceStore.Web.Data.Entities.PhieuNhap>
@using ConvenienceStore.Web.Modules.Auth.Security
@{
    ViewData["Title"] = "Phiếu nhập";
    var pageNumber = (int)ViewBag.Page;
    var status = (string?)ViewBag.Status;
}
<h1>Phiếu nhập</h1>
@if (User.HasClaim("quyen", MaQuyen.NhaCungCapQuanLy))
{
    <p><a asp-controller="Suppliers" asp-action="Index">Nhà cung cấp</a></p>
}
<p><a asp-controller="StockOverview" asp-action="Index">Xem tồn kho</a></p>
@if (User.HasClaim("quyen", MaQuyen.PhieuNhapLap))
{
    <a class="btn btn-primary mb-3" asp-action="Create">Lập phiếu nhập</a>
}
<form asp-action="Index" method="get" class="d-flex gap-2 mb-3">
    <input class="form-control" name="q" value="@ViewBag.Term" placeholder="Mã phiếu hoặc nhà cung cấp" aria-label="Tìm phiếu nhập">
    <select class="form-select" name="status" aria-label="Trạng thái phiếu nhập">
        <option value="">Mọi trạng thái</option>
        <option value="NHAP" selected="@(status == "NHAP")">Nháp</option>
        <option value="DA_NHAP_KHO" selected="@(status == "DA_NHAP_KHO")">Đã nhập kho</option>
        <option value="DA_HUY" selected="@(status == "DA_HUY")">Đã hủy</option>
    </select>
    <button type="submit" class="btn btn-primary">Tìm</button>
</form>
@if (Model.Count == 0) { <p>Không tìm thấy phiếu nhập.</p> }
else
{
    <table class="table">
        <thead><tr><th>Mã phiếu</th><th>Nhà cung cấp</th><th>Ngày nhập</th><th>Trạng thái</th><th>Tổng tiền</th><th>Người lập</th></tr></thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr><td><a asp-action="Details" asp-route-id="@row.Id">@row.MaPhieu</a></td><td>@row.NhaCungCap.Ten</td><td>@row.NgayNhap.ToString("dd/MM/yyyy")</td><td>@row.TrangThai</td><td>@row.TongTien.ToString("N0") đ</td><td>@row.NguoiLap.HoTen</td></tr>
        }
        </tbody>
    </table>
}
@if (pageNumber > 1) { <a asp-action="Index" asp-route-q="@ViewBag.Term" asp-route-status="@status" asp-route-page="@(pageNumber - 1)">Trang trước</a> }
@if (ViewBag.HasNext) { <a asp-action="Index" asp-route-q="@ViewBag.Term" asp-route-status="@status" asp-route-page="@(pageNumber + 1)">Trang sau</a> }
