@model ConvenienceStore.Web.Models.Pos.PosPageViewModel

@{
    ViewData["Title"] = "Quầy bán hàng";
    Layout = "_AdminLayout";
}

<link rel="stylesheet"
      href="~/css/pos.css"
      asp-append-version="true" />

<!-- TIÊU ĐỀ TRANG POS -->
<div class="pos-head">
    <div>
        <h1>Quầy bán hàng</h1>
        <p>
            Tìm kiếm sản phẩm, thêm vào giỏ hàng và thanh toán
        </p>
    </div>

    <span class="badge text-bg-primary">
        Giỏ hàng: @Model.Cart.TotalQuantity sản phẩm
    </span>
</div>

<!-- THÔNG BÁO LỖI -->
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

<!-- THÔNG BÁO THÀNH CÔNG -->
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">
        @success
    </div>
}

<div class="pos-grid">

    <!-- ================================= -->
    <!-- KHU VỰC 1: CHỌN SẢN PHẨM -->
    <!-- ================================= -->

    <section class="pos-panel">

        <h2>1. Chọn sản phẩm</h2>

        <!-- TÌM KIẾM VÀ LỌC DANH MỤC -->
        <form method="get"
              asp-controller="Pos"
              asp-action="Index"
              class="pos-search">

            <input name="search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Tìm tên hoặc mã sản phẩm"
                   aria-label="Tìm sản phẩm" />

            <select name="categoryId"
                    class="form-select"
                    aria-label="Chọn danh mục">

                <option value="">
                    Tất cả danh mục
                </option>

                @foreach (var category in Model.Categories)
                {
                    if (Model.CategoryId == category.Id)
                    {
                        <option value="@category.Id" selected>
                            @category.Name
                        </option>
                    }
                    else
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }
                }
            </select>

            <button class="btn btn-primary"
                    type="submit">
                Tìm kiếm
            </button>

        </form>

        <!-- DANH SÁCH SẢN PHẨM -->
        <div class="pos-products">

            @foreach (var product in Model.Products)
            {
                <article class="pos-product">

                    <div>
                        <strong>
                            @product.Name
                        </strong>

                        <div class="text-muted small">
                            Mã: @product.Code
                            · Còn lại: @product.Stock
                        </div>

                        <div class="pos-price">
                            @product.Price.ToString("N0") đ
                        </div>
                    </div>

                    <!-- THÊM SẢN PHẨM VÀO GIỎ -->
                    <form asp-controller="Pos"
                          asp-action="Add"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="productId"
                               value="@product.Id" />

                        <button class="btn btn-outline-primary btn-sm"
                                type="submit"
                                disabled="@(product.Stock <= 0)">
                            + Thêm
                        </button>

                    </form>

                </article>
            }

            <!-- NGOẠI LỆ E1 -->
            @if (!Model.Products.Any())
            {
                <p class="text-muted">
                    Không có sản phẩm phù hợp.
                </p>
            }

        </div>

    </section>

    <!-- ================================= -->
    <!-- KHU VỰC 2: GIỎ HÀNG -->
    <!-- ================================= -->

    <section class="pos-panel">

        <h2>2. Giỏ hàng</h2>

        <!-- GIỎ HÀNG TRỐNG -->
        @if (!Model.Cart.Items.Any())
        {
            <p class="text-muted">
                Chưa có sản phẩm trong giỏ.
            </p>
        }

        <!-- DANH SÁCH SẢN PHẨM TRONG GIỎ -->
        @foreach (var item in Model.Cart.Items)
        {
            <div class="pos-cart-row">

                <!-- THÔNG TIN SẢN PHẨM -->
                <div>
                    <strong>@item.Name</strong>

                    <div class="text-muted small">
                        Đơn giá:
                        @item.UnitPrice.ToString("N0") đ
                        × @item.Quantity
                    </div>

                    <div class="fw-semibold">
                        Thành tiền:
                        @item.Total.ToString("N0") đ
                    </div>
                </div>

                <!-- POS-02: CHỈNH SỬA GIỎ HÀNG -->
                <div class="pos-actions">

                    <!-- NÚT GIẢM SỐ LƯỢNG -->
                    <form asp-controller="Pos"
                          asp-action="Update"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="productId"
                               value="@item.ProductId" />

                        <input type="hidden"
                               name="quantity"
                               value="@(item.Quantity - 1)" />

                        <button type="submit"
                                class="btn btn-outline-secondary btn-sm"
                                aria-label="Giảm số lượng @item.Name">
                            −
                        </button>
                    </form>

                    <!-- NHẬP SỐ LƯỢNG -->
                    <form asp-controller="Pos"
                          asp-action="Update"
                          method="post"
                          class="d-flex gap-1 align-items-center">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="productId"
                               value="@item.ProductId" />

                        <input class="form-control form-control-sm pos-qty"
                               type="number"
                               name="quantity"
                               min="0"
                               step="1"
                               required
                               value="@item.Quantity"
                               aria-label="Số lượng @item.Name" />

                        <button type="submit"
                                class="btn btn-outline-primary btn-sm">
                            Sửa
                        </button>
                    </form>

                    <!-- NÚT TĂNG SỐ LƯỢNG -->
                    <form asp-controller="Pos"
                          asp-action="Update"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="productId"
                               value="@item.ProductId" />

                        <input type="hidden"
                               name="quantity"
                               value="@(item.Quantity + 1)" />

                        <button type="submit"
                                class="btn btn-outline-secondary btn-sm"
                                aria-label="Tăng số lượng @item.Name">
                            +
                        </button>
                    </form>

                    <!-- XÓA SẢN PHẨM -->
                    <form asp-controller="Pos"
                          asp-action="Remove"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="productId"
                               value="@item.ProductId" />

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm">
                            Xóa
                        </button>
                    </form>

                </div>

            </div>
        }

        <!-- ================================= -->
        <!-- BẢNG TỔNG TIỀN - CHỈ HIỂN THỊ 1 LẦN -->
        <!-- ================================= -->

        <div class="pos-total">

            <!-- TẠM TÍNH -->
            <div class="pos-total-row">
                <span>Tạm tính:</span>

                <strong>
                    @Model.Cart.Subtotal.ToString("N0") đ
                </strong>
            </div>

            <!-- GIẢM GIÁ POS-04 -->
            <div class="pos-total-row">
                <span>Giảm giá:</span>

                <strong>
                    @Model.Cart.Discount.ToString("N0") đ
                </strong>
            </div>

            <hr />

            <!-- TỔNG PHẢI TRẢ -->
            <div class="pos-total-row pos-grand-total">
                <strong>Tổng phải trả:</strong>

                <strong>
                    @Model.Cart.Total.ToString("N0") đ
                </strong>
            </div>

        </div>

        <!-- ================================= -->
        <!-- KHU VỰC 3: TÍNH TIỀN MẶT -->
        <!-- ================================= -->

        <h2 class="mt-4">
            3. Thanh toán tiền mặt
        </h2>

        <form asp-controller="Pos"
              asp-action="Calculate"
              method="post"
              class="pos-pay">

            @Html.AntiForgeryToken()

            <label for="cashReceived">
                Tiền khách đưa (VND)
            </label>

            <input class="form-control"
                   id="cashReceived"
                   name="cashReceived"
                   type="number"
                   min="0"
                   step="100"
                   required
                   value="@Model.CashReceived" />

            <button class="btn btn-success"
                    type="submit"
                    disabled="@(!Model.Cart.Items.Any())">
                Tính tiền thừa
            </button>

        </form>

        <!-- HIỂN THỊ TIỀN THỪA -->
        @if (Model.Change.HasValue)
        {
            <div class="alert alert-success mt-3">

                <div>
                    Khách đưa:
                    <strong>
                        @Model.CashReceived!.Value.ToString("N0") đ
                    </strong>
                </div>

                <div>
                    Tiền thừa:
                    <strong>
                        @Model.Change.Value.ToString("N0") đ
                    </strong>
                </div>

            </div>
        }

        <div class="alert alert-info small mt-3">
            Nhập số tiền khách đưa để tính tiền thừa.
        </div>

        <!-- ================================= -->
        <!-- HỦY ĐƠN HÀNG -->
        <!-- ================================= -->

        <form asp-controller="Pos"
              asp-action="Cancel"
              method="post"
              onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn đang bán?');">

            @Html.AntiForgeryToken()

            <button class="btn btn-outline-danger w-100"
                    type="submit"
                    disabled="@(!Model.Cart.Items.Any())">
                Hủy đơn hàng
            </button>

        </form>

    </section>

</div>
