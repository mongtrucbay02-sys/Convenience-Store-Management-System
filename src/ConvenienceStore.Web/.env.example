# PostgreSQL 17 only. Use a secret manager or an ignored .env beside the web project.
Database__Provider=PostgreSql
# Supabase: use your private backend role and verified TLS settings; never commit its password.
# Download the official project CA outside Git. SupabaseSmoke requires an explicit existing Root Certificate file.
ConnectionStrings__CuaHang=Host=YOUR_SUPABASE_HOST;Port=5432;Database=postgres;Username=smartmart_backend;Password=YOUR_SECRET;SSL Mode=VerifyFull;Root Certificate=YOUR_CA_CERTIFICATE_PATH;Search Path=smartmart;Timezone=Asia/Ho_Chi_Minh
AdminDauTien__TenDangNhap=
AdminDauTien__MatKhauTam=
# Tests accept loopback only and create/drop randomly named databases. Never use a shared database.
ConnectionStrings__CuaHangPostgreSqlTest=Host=127.0.0.1;Port=55439;Database=postgres;Username=YOUR_LOCAL_TEST_ADMIN;Password=YOUR_LOCAL_TEST_SECRET;Pooling=false
