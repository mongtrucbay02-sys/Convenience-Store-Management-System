@model ConvenienceStore.Web.Modules.Returns.Services.ApprovalDetails
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Duyệt đổi trả ngoại lệ";
    var slip = Model.Slip;
}
@await Html.PartialAsync("~/Modules/Returns/Views/_ApprovalSlip.cshtml", Model)
@if (slip.Kind == "DOI_HANG")
{
    <p class="alert alert-warning" role="alert">Tạm chặn duyệt phương án đổi cho đến khi thiết kế snapshot được phê duyệt. Không nhận tiền hoặc hoàn tất bằng giỏ POS hiện tại. Admin vẫn có thể từ chối phiếu.</p>
}
@if (slip.Status == "CHO_DUYET")
{
    <form method="post" action="@Url.Action("Decide", "ReturnApprovals", new { id = slip.Id })">
        @Html.AntiForgeryToken()
        <label class="form-label" for="approval-note">Ghi chú quyết định</label>
        <textarea class="form-control mb-3" id="approval-note" name="note" maxlength="255" required></textarea>
        @if (slip.Kind == "TRA_HANG" && slip.ReturnValue > 0)
        {
            <label class="d-block mb-3"><input type="checkbox" name="refundConfirmed" value="true" />
                Tôi xác nhận trực tiếp hoàn @slip.ReturnValue.ToString("N0") đ tiền mặt cho khách; sổ quỹ ghi tài khoản Admin đang đăng nhập là người thực hiện.
            </label>
        }
        @if (slip.Kind == "TRA_HANG")
        {
            <button class="btn btn-success" type="submit" name="decision" value="approve">Duyệt</button>
        }
        <button class="btn btn-outline-danger" type="submit" name="decision" value="reject">Từ chối</button>
    </form>
}
<a class="d-inline-block mt-3" href="@Url.Action("Index", "ReturnApprovals")">Về danh sách chờ duyệt</a>
