@model IReadOnlyList<ConvenienceStore.Web.Modules.Inventory.Controllers.StockOverviewRow>
@using ConvenienceStore.Web.Modules.Auth.Security
@using ConvenienceStore.Web.Data.Entities
@{
    ViewData["Title"] = "Tồn kho";
    var pageNumber = (int)ViewBag.Page;
    var showCost = (bool)ViewBag.ShowCost;
    var showThreshold = (bool)ViewBag.ShowThreshold;
    var categoryId = (long?)ViewBag.CategoryId;
    var status = (string?)ViewBag.Status;
    var categories = (IReadOnlyList<DanhMuc>)ViewBag.Categories;
    var showHistory = User.HasClaim("quyen", MaQuyen.TheKhoCanhBaoXem);
}
<h1>Tồn kho hiện tại</h1>
<nav class="smartmart-action-row" aria-label="Thao tác kho">
    @if (showHistory)
    {
        <a class="btn btn-outline-success" asp-controller="StockDocuments" asp-action="Index">Kiểm kê và xuất hủy</a>
        <a class="btn btn-outline-success" asp-action="Alerts">Cảnh báo tồn kho</a>
    }
    @if (User.HasClaim("quyen", MaQuyen.NguongTonSua))
    {
        <a class="btn btn-outline-success" asp-action="Thresholds">Thiết lập ngưỡng tồn</a>
    }
</nav>
<form method="get" asp-action="Index" class="smartmart-filter-row">
    <input class="form-control" name="q" value="@ViewBag.Term" aria-label="Tìm mã hoặc tên sản phẩm" placeholder="Tìm mã hoặc tên sản phẩm">
    <select class="form-select" name="categoryId" aria-label="Danh mục">
        <option value="">Mọi danh mục</option>
        @foreach (var category in categories)
        {
            <option value="@category.Id" selected="@(category.Id == categoryId)">@category.Ten</option>
        }
    </select>
    <select class="form-select" name="status" aria-label="Trạng thái tồn">
        <option value="">Mọi trạng thái</option>
        <option value="out" selected="@(status == "out")">Hết</option>
        <option value="low" selected="@(status == "low")">Sắp hết</option>
        <option value="enough" selected="@(status == "enough")">Đủ</option>
    </select>
    <button class="btn btn-primary" type="submit">Tìm</button>
</form>
@if (Model.Count == 0) { <p>Không tìm thấy sản phẩm.</p> }
else
{
    <div class="table-responsive smartmart-data-table" role="region" aria-label="Danh sách tồn kho" tabindex="0">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Mã</th><th>Sản phẩm</th><th>Danh mục</th><th>Tồn</th><th>Trạng thái</th>@if (showThreshold) { <th>Ngưỡng tối thiểu</th> }@if (showCost) { <th>Giá vốn bình quân</th><th>Giá trị tồn</th> }</tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr><td>@item.Code</td><td>
                @if (showHistory) { <a asp-action="History" asp-route-id="@item.Id">@item.Name</a> }
                else { @item.Name }
            </td><td>@item.Category</td><td>@item.Quantity</td><td>@item.Status</td>@if (showThreshold) { <td>@item.Threshold</td> }@if (showCost) { <td>@item.Cost?.ToString("N2")</td><td>@((item.Cost * item.Quantity)?.ToString("N2"))</td> }</tr>
        }
        </tbody>
    </table>
    </div>
}
@if (pageNumber > 1) { <a asp-action="Index" asp-route-q="@ViewBag.Term" asp-route-categoryId="@categoryId" asp-route-status="@status" asp-route-page="@(pageNumber - 1)">Trang trước</a> }
@if (ViewBag.HasNext) { <a asp-action="Index" asp-route-q="@ViewBag.Term" asp-route-categoryId="@categoryId" asp-route-status="@status" asp-route-page="@(pageNumber + 1)">Trang sau</a> }
