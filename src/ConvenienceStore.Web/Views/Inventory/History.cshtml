@model IReadOnlyList<ConvenienceStore.Web.Modules.Inventory.Controllers.StockMovementRow>
@{
    ViewData["Title"] = "Thẻ kho";
    var pageNumber = (int)ViewBag.Page;
}
<h1>Thẻ kho</h1>
<p>@ViewBag.Product</p>
<form asp-action="History" asp-route-id="@ViewBag.ProductId" method="get" class="d-flex gap-2 mb-3">
    <label>Từ ngày<input type="date" name="from" value="@ViewBag.From" class="form-control"></label>
    <label>Đến ngày<input type="date" name="to" value="@ViewBag.To" class="form-control"></label>
    <button type="submit" class="btn btn-primary align-self-end">Lọc</button>
</form>
@if (Model.Count == 0) { <p>Không có biến động trong khoảng đã chọn.</p> }
else
{
    <table class="table">
        <thead><tr><th>Thời điểm</th><th>Loại</th><th>Chứng từ</th><th>Thay đổi</th><th>Tồn sau</th><th>Người thực hiện</th></tr></thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr><td>@row.Time.ToString("dd/MM/yyyy HH:mm")</td><td>@row.Type</td><td>@row.Document</td><td>@row.Change</td><td>@row.Balance</td><td>@row.Actor</td></tr>
        }
        </tbody>
    </table>
}
@if (pageNumber > 1) { <a asp-action="History" asp-route-id="@ViewBag.ProductId" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-page="@(pageNumber - 1)">Trang trước</a> }
@if (ViewBag.HasNext) { <a asp-action="History" asp-route-id="@ViewBag.ProductId" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-page="@(pageNumber + 1)">Trang sau</a> }
<p class="mt-3"><a asp-action="Index">Quay lại tồn kho</a></p>
