@model ConvenienceStore.Web.Modules.Returns.Services.ApprovalDetails
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Phiếu đổi ngoại lệ";
    var slip = Model.Slip;
}
@await Html.PartialAsync("~/Modules/Returns/Views/_ApprovalSlip.cshtml", Model)
@if (slip.Status is "CHO_DUYET" or "DA_DUYET")
{
    <p class="alert alert-warning" role="alert">Tạm chặn hoàn tất phiếu đổi ngoại lệ vì chưa có thiết kế lưu phương án đã duyệt. Không nhận thêm tiền và không dùng giỏ POS hiện tại để thay thế.</p>
}
else if (slip.Status == "HOAN_TAT")
{
    <a href="@Url.Action("ExchangeReceipt", "ReturnOrders", new { id = slip.Id })">Xem biên nhận đổi hàng</a>
}
<a class="d-inline-block mt-3" href="@Url.Action("ApprovedExchanges", "ReturnApprovals")">Về danh sách phiếu đổi đã duyệt</a>
