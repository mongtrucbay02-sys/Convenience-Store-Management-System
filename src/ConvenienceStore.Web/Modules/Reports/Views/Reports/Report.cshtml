@using System.Globalization
@using ConvenienceStore.Web.Modules.Reports.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model OperationalReportResponse
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = Model.Title;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var max = Math.Max(1, Model.Chart.Select(p => Math.Max(p.Value, p.SecondaryValue ?? 0)).DefaultIfEmpty(1).Max());
    var showProfit = Model.Code == "BC-08";
    var min = Math.Min(0, Model.Chart.Select(p => Math.Min(p.Value, p.SecondaryValue ?? 0)).DefaultIfEmpty(0).Min());
    var scale = (decimal)max - min;
    string AxisPercent(decimal value) => value.ToString("0.####", CultureInfo.InvariantCulture) + "%";
    string BarPosition(long value) => AxisPercent((Math.Min(value, 0) - (decimal)min) * 100 / scale);
    string BarHeight(long value) => AxisPercent(Math.Abs((decimal)value) * 100 / scale);
    var actionName = Model.Code switch { "BC-02" => "Revenue", "BC-03" => "Products", "BC-04" => "Categories", "BC-05" => "Cashiers", "BC-06" => "Inventory", "BC-07" => "Purchases", _ => "GrossProfit" };
    var categories = ViewData["ReportCategories"] as Microsoft.AspNetCore.Mvc.Rendering.SelectListItem[];
    var suppliers = ViewData["ReportSuppliers"] as Microsoft.AspNetCore.Mvc.Rendering.SelectListItem[];
    var customRange = string.Equals(Model.Query.Period, "custom", StringComparison.OrdinalIgnoreCase)
        || Model.Range.Period == "custom";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div><div class="small text-muted">@Model.Code · Báo cáo và thống kê</div><h1 class="h3 mb-0">@Model.Title</h1></div>
</div>


<form method="get" asp-area="Reports" asp-controller="Reports" asp-action="@actionName" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-lg-2"><label class="form-label" for="period">Khoảng thời gian</label>
            <select class="form-select" id="period" name="Period">
                <option value="today" selected="@(!customRange && Model.Query.Period == "today")">Hôm nay</option>
                <option value="last7days" selected="@(!customRange && Model.Query.Period == "last7days")">7 ngày</option>
                <option value="thisMonth" selected="@(!customRange && Model.Query.Period == "thisMonth")">Tháng này</option>
                <option value="lastMonth" selected="@(!customRange && Model.Query.Period == "lastMonth")">Tháng trước</option>
                <option value="custom" selected="@customRange">Tùy chọn</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-2"><label class="form-label" for="from">Từ ngày</label><input class="form-control" id="from" type="date" name="From" disabled="@(!customRange)" value="@(Model.Query.From?.ToString("yyyy-MM-dd") ?? Model.Range.From.ToString("yyyy-MM-dd"))" /></div>
        <div class="col-sm-6 col-lg-2"><label class="form-label" for="to">Đến ngày</label><input class="form-control" id="to" type="date" name="To" disabled="@(!customRange)" value="@(Model.Query.To?.ToString("yyyy-MM-dd") ?? Model.Range.To.ToString("yyyy-MM-dd"))" /></div>
        @if (Model.Code == "BC-02")
        {
            <div class="col-sm-6 col-lg-2"><label class="form-label" for="groupBy">Nhóm theo</label><select class="form-select" name="GroupBy" id="groupBy"><option value="day" selected="@(Model.Query.GroupBy == "day")">Ngày</option><option value="week" selected="@(Model.Query.GroupBy == "week")">Tuần</option><option value="month" selected="@(Model.Query.GroupBy == "month")">Tháng</option></select></div>
        }
        @if (Model.Code is "BC-03" or "BC-06" or "BC-08")
        {
            <div class="col-sm-6 col-lg-2"><label class="form-label" for="categoryId">Danh mục</label><select class="form-select" id="categoryId" name="CategoryId" asp-items="categories"><option value="">Tất cả</option></select></div>
            <div class="col-sm-6 col-lg-2"><label class="form-label" for="productId">Sản phẩm ID</label><input class="form-control" id="productId" type="number" min="1" name="ProductId" value="@Model.Query.ProductId" /></div>
        }
        @if (Model.Code == "BC-03")
        {
            <div class="col-sm-6 col-lg-2"><label class="form-label" for="topN">Top</label><select class="form-select" id="topN" name="TopN"><option value="10" selected="@(Model.Query.TopN == 10)">10</option><option value="20" selected="@(Model.Query.TopN == 20)">20</option><option value="50" selected="@(Model.Query.TopN == 50)">50</option></select></div>
            <div class="col-sm-6 col-lg-2"><label class="form-label" for="sortBy">Sắp xếp</label><select class="form-select" id="sortBy" name="SortBy"><option value="quantity" selected="@(Model.Query.SortBy == "quantity")">Số lượng</option><option value="revenue" selected="@(Model.Query.SortBy == "revenue")">Doanh thu</option></select></div>
        }
        @if (Model.Code == "BC-05")
        {
            <div class="col-sm-6 col-lg-2"><label class="form-label" for="cashierId">Thu ngân ID</label><input class="form-control" id="cashierId" type="number" min="1" name="CashierId" value="@Model.Query.CashierId" /></div>
        }
        @if (Model.Code == "BC-06")
        {
            <div class="col-sm-6 col-lg-2"><label class="form-label" for="stockStatus">Trạng thái tồn</label><select class="form-select" id="stockStatus" name="StockStatus"><option value="all" selected="@(Model.Query.StockStatus == "all")">Tất cả</option><option value="low" selected="@(Model.Query.StockStatus == "low")">Sắp hết</option><option value="out" selected="@(Model.Query.StockStatus == "out")">Hết hàng</option></select></div>
        }
        @if (Model.Code == "BC-07")
        {
            <div class="col-sm-6 col-lg-2"><label class="form-label" for="supplierId">Nhà cung cấp</label><select class="form-select" id="supplierId" name="SupplierId" asp-items="suppliers"><option value="">Tất cả</option></select></div>
            <div class="col-sm-6 col-lg-2"><label class="form-label" for="productId">Sản phẩm ID</label><input class="form-control" id="productId" type="number" min="1" name="ProductId" value="@Model.Query.ProductId" /></div>
        }
        <div class="col-sm-6 col-lg-2 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Xem</button>
            @if (Model.Message is null)
            {
                <a class="btn btn-outline-secondary" asp-area="Reports" asp-controller="Reports" asp-action="Export"
                   asp-route-code="@Model.Code" asp-route-Period="@Model.Query.Period"
                   asp-route-From="@Model.Query.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.Query.To?.ToString("yyyy-MM-dd")"
                   asp-route-GroupBy="@Model.Query.GroupBy" asp-route-CategoryId="@Model.Query.CategoryId"
                   asp-route-ProductId="@Model.Query.ProductId" asp-route-CashierId="@Model.Query.CashierId"
                   asp-route-TopN="@Model.Query.TopN" asp-route-SortBy="@Model.Query.SortBy"
                   asp-route-SupplierId="@Model.Query.SupplierId"
                   asp-route-StockStatus="@Model.Query.StockStatus">Xuất Excel</a>
            }
            else
            {
                <button class="btn btn-outline-secondary" type="button" disabled title="Không có dữ liệu để xuất">Xuất Excel</button>
            }
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    @foreach (var metric in Model.Metrics)
    {
        <div class="col-6 col-lg-@(12 / Math.Clamp(Model.Metrics.Count, 1, 6))"><div class="card h-100"><div class="card-body py-3"><div class="small text-muted">@metric.Label</div><div class="fs-5 fw-semibold">@(metric.Format == "currency" ? metric.Value.ToString("N0", vi) + " ₫" : metric.Format == "percent" ? (metric.Value / 10m).ToString("N1", vi) + "%" : metric.Value.ToString("N0", vi))</div></div></div></div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info" role="status">@Model.Message</div>
}
@if (TempData["ReportExportError"] is string exportError)
{
    <div class="alert alert-danger" role="alert">@exportError</div>
}

@if (Model.Chart.Count > 0 && Model.Code != "BC-06")
{
    <section class="card mb-3"><div class="card-body">
        <h2 class="h6">Biểu đồ</h2>
        @if (Model.Code is "BC-02" or "BC-08")
        {
            @if (showProfit)
            {
                <div class="d-flex flex-wrap gap-3 small mb-3">
                    <span><span class="text-primary" aria-hidden="true">■</span> Doanh thu thuần</span>
                    <span><span class="text-success" aria-hidden="true">■</span> Lợi nhuận gộp</span>
                </div>
            }
            <div class="position-relative d-flex" role="img" aria-label="@(showProfit ? "Biểu đồ cột doanh thu thuần và lợi nhuận gộp theo kỳ" : "Biểu đồ cột doanh thu thuần theo kỳ")" style="height:220px">
                <div class="position-absolute start-0 end-0 border-top border-secondary" aria-hidden="true" style="bottom:@BarPosition(0)"></div>
                @foreach (var point in Model.Chart)
                {
                    <div class="d-flex justify-content-center position-relative" style="flex:1;min-width:0"
                         title="@point.Label · Doanh thu thuần @point.Value.ToString("N0", vi) ₫@(point.SecondaryValue is long profit ? " · Lợi nhuận gộp " + profit.ToString("N0", vi) + " ₫" : "")">
                        <span class="position-absolute bg-primary rounded-top" style="@(showProfit ? "right:51%;width:36%" : "width:72%");max-width:38px;height:@BarHeight(point.Value);bottom:@BarPosition(point.Value)"></span>
                        @if (showProfit && point.SecondaryValue is long secondary)
                        {
                            <span class="position-absolute bg-success rounded-top" style="width:36%;max-width:38px;left:51%;height:@BarHeight(secondary);bottom:@BarPosition(secondary)"></span>
                        }
                    </div>
                }
            </div>
            <div class="d-flex @(Model.Chart.Count == 1 ? "justify-content-center" : "justify-content-between") small text-muted mt-2">
                <span>@Model.Chart.First().Label</span>
                @if (Model.Chart.Count > 1)
                {
                    <span>@Model.Chart.Last().Label</span>
                }
            </div>
        }
        else
        {
            <div class="d-grid gap-2">
                @foreach (var point in Model.Chart)
                {
                    var width = Math.Max(1, point.Value * 100 / max);
                    <div><div class="d-flex justify-content-between small"><span>@point.Label</span><span>@point.Value.ToString("N0", vi)</span></div><div class="progress" role="img" aria-label="@point.Label"><div class="progress-bar" style="width:@(width)%"></div></div></div>
                }
            </div>
        }
    </div></section>
}

<section class="card"><div class="card-body">
    <h2 class="h6">Chi tiết số liệu · @Model.Range.From.ToString("dd/MM/yyyy") – @Model.Range.To.ToString("dd/MM/yyyy") (UTC+7)</h2>
    <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr>@foreach (var column in Model.Columns){<th scope="col">@column</th>}</tr></thead><tbody>
    @foreach (var row in Model.Rows)
    {
        <tr data-row-key="@row.Key">
            @for (var columnIndex = 0; columnIndex < row.Cells.Count; columnIndex++)
            {
                <td>
                    @if (columnIndex == 0 && row.Key != "total")
                    {
                        <a asp-area="Reports" asp-controller="Reports" asp-action="Detail"
                           asp-route-code="@Model.Code" asp-route-key="@row.Key"
                           asp-route-Period="@Model.Query.Period" asp-route-From="@Model.Query.From?.ToString("yyyy-MM-dd")"
                           asp-route-To="@Model.Query.To?.ToString("yyyy-MM-dd")" asp-route-GroupBy="@Model.Query.GroupBy">@row.Cells[columnIndex]</a>
                    }
                    else { @row.Cells[columnIndex] }
                </td>
            }
        </tr>
    }
    </tbody></table></div>
    @if (Model.Rows.Count == 0){<div class="text-muted py-3">Không có dữ liệu trong khoảng đã chọn</div>}
</div></section>

<p class="small text-muted mt-2 mb-0">Số liệu theo kỳ đã chọn (UTC+7). Doanh thu và giá vốn sử dụng dữ liệu giao dịch lưu tại thời điểm phát sinh.</p>

@section Scripts {
    <script>
        (() => {
            const period = document.getElementById('period');
            const dates = [document.getElementById('from'), document.getElementById('to')];
            const sync = () => dates.forEach(input => input.disabled = period.value !== 'custom');
            period.addEventListener('change', sync);
            sync();
        })();
    </script>
}
